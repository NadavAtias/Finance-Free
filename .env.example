# Copy to .env (never commit .env). Only needed for providers that require a key.
TIINGO_API_KEY=
# Telegram alerts (optional): create a bot with @BotFather, then message it once and
# read your chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Data source override for the paper loop (default: the config's provider, yahoo).
# Set to tiingo (and fill TIINGO_API_KEY) if Yahoo blocks your server.
FF_PROVIDER=
# Phase 4 signals. SEC EDGAR blocks requests without a name and email in the
# User-Agent (their fair-access rule). Format: "Your Name you@example.com".
SEC_USER_AGENT=
# Optional: free key from https://fred.stlouisfed.org/docs/api/api_key.html adds CPI
# and jobs-report dates to the dashboard's calendar. Not needed for the signals.
FRED_API_KEY=
