#!/bin/sh
# Finance Free launcher: `./ff <command> ...` from anywhere.
# Installs the project as a regular (non-editable) package, rebuilt when the code
# changes, so it doesn't depend on the editable-install .pth file that macOS can
# hide (Python 3.13+ skips hidden .pth files -> "No module named 'ff'").
cd "$(dirname "$0")" || exit 1
[ -f "$HOME/.local/bin/env" ] && . "$HOME/.local/bin/env"
exec uv run --no-editable ff "$@"
